# Local company settings. Copy to .env.company; keep private files out of Git.
# npm run company loads .env.local first, then .env.company.
# The supervised launcher pins loopback/local-only isolation. Direct cargo run
# does not automatically read either file. No inference API key is required.
AUTH_MODE=local
BIND=127.0.0.1:8788
CONFIG=config/company.local.json
RUN_STORE=data/company-runs.sqlite3
GENTS_LOCAL_ONLY=1
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
TRANSFORMERS_OFFLINE=1
# stdio or sse (owned loopback Streamable HTTP). Explicit launcher value wins.
GENTS_MCP_TRANSPORT=stdio

# Optional email integration, disabled by default. Not needed for local tasks.
# Sending/receiving mail may have provider charges; it is outside $0 local tools.
# Keep the credential in .env.local. Enable only a reviewed dedicated mailbox.
# GENTS_EMAIL_PROVIDER=resend
# GENTS_EMAIL_FROM="Gents <gents@your-verified-domain.example>"
# GENTS_EMAIL_DEFAULT_TO=you@example.com
# GENTS_EMAIL_INBOX=gents@requests.your-verified-domain.example
# GENTS_EMAIL_ALLOWED_SENDERS=you@example.com
# GENTS_EMAIL_ALLOWED_RECIPIENTS=you@example.com
GENTS_EMAIL_AUTO_START=0

# Alternative dedicated IMAP/SMTP setup (credentials in .env.local):
# GENTS_EMAIL_PROVIDER=imap
# GENTS_EMAIL_USER=gents@example.com
# GENTS_EMAIL_FROM=gents@example.com
# GENTS_IMAP_HOST=imap.example.com
# GENTS_IMAP_FOLDER=INBOX
# GENTS_SMTP_HOST=smtp.example.com
# GENTS_SMTP_PORT=465
# Optional local image/speech engines need no API keys. See mcp/media/README.md;
# their model and interpreter pins live in config/media.local.json.
