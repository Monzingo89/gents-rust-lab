# Copy to .env.company. npm run company loads .env.local, then .env.company.
# Existing keys may stay in .env.local; .env.company values take precedence.
# Never paste real values into chat or into the task UI.

# No paid inference API key is needed. Public HF models need no token.
# HF_TOKEN=  # optional read token for gated/private models; accept the license first

# Dedicated email API option (inbound + outbound):
# GENTS_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# GENTS_EMAIL_FROM=Gents <gents@your-verified-domain.example>
# GENTS_EMAIL_DEFAULT_TO=you@example.com
# For reading requests: exact dedicated address routed to Resend, NOT Gmail.
# GENTS_EMAIL_INBOX=gents@requests.your-verified-domain.example

# Or a dedicated IMAP/SMTP mailbox (Gmail/Outlook/custom provider):
# GENTS_EMAIL_PROVIDER=imap
# GENTS_EMAIL_USER=gents@example.com
# GENTS_EMAIL_PASSWORD=  # mailbox app password, never your normal account password
# GENTS_EMAIL_FROM=gents@example.com
# GENTS_IMAP_HOST=imap.example.com
# GENTS_IMAP_FOLDER=INBOX
# GENTS_SMTP_HOST=smtp.example.com
# GENTS_SMTP_PORT=465

# Only these addresses may submit requests / receive company emails:
# GENTS_EMAIL_ALLOWED_SENDERS=you@example.com
# GENTS_EMAIL_ALLOWED_RECIPIENTS=you@example.com
# Leave off until a dedicated receiving inbox is configured and reviewed.
# Set to 1 to turn allowlisted inbound messages into company task requests.
# GENTS_EMAIL_AUTO_START=0
