# Optional private shared credentials. Copy to .env.local only if needed.
# Local inference and the static website need NO API key. Leave these commented.
# Never use a VITE_/NEXT_PUBLIC_ prefix for any secret: those expose client data.
# Never upload .env.local or .env.company to Vercel or include them in a prompt.

# Optional reviewed download of a gated/private Hugging Face model.
# Public models need no token. Accept the model license first; prefer read scope.
# HF_TOKEN=

# Optional dedicated mail credentials; configure addresses in .env.company.
# Mail is outside the free/offline task path and may have provider charges.
# RESEND_API_KEY=
# GENTS_EMAIL_PASSWORD=  # app password; never the normal mailbox password

# Existing advanced/legacy cloud credentials may stay private here, but they
# do not enable cloud inference while GENTS_LOCAL_ONLY=1. None are required.
GENTS_LOCAL_ONLY=1

# Hosted support settings have their own .env.website.local.example template.
