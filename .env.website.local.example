# Hosted support settings only. Copy to .env.website.local if maintaining locally.
# The local company launcher does NOT load this file. Use npm run site:env:check, then npm run site:env:sync to update production.
# Use a dedicated Resend sending-only key for the website. Never send keys
# to the browser, agent prompts, public Git, or form submissions.
RESEND_API_KEY=
SUPPORT_ENABLED=0
SUPPORT_FROM="Gents <support@your-verified-domain.example>"
SUPPORT_TO=your-support-recipient@example.com
# Generate at least 32 random bytes locally; set as a Vercel Secret.
SUPPORT_SIGNING_SECRET=
# Exact HTTPS origins, comma-separated when multiple aliases are intended.
SUPPORT_ORIGIN=https://metivolve.com
