# The Rust process reads environment variables, not this file automatically.
AUTH_MODE=local
BIND=127.0.0.1:8787
CONFIG=config/mock.json
# Live providers: export only keys for providers actually enabled.
# OPENROUTER_API_KEY=
# HF_TOKEN=
# DATABRICKS_TOKEN=
# TENANT_ID=
# API_CLIENT_ID=
# NATIVE_CLIENT_ID=
# CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

RUN_STORE=data/runs.sqlite3
RUN_RETENTION_HOURS=168
# PROVIDER_ALLOWED_HOSTS=explicit-extra-host.example.com

# Local GGUF POC (no API key):
# CONFIG=config/local-poc.json
# LLAMA_SERVER=/absolute/path/to/llama-server
# LOCAL_MODEL_PORT=8791

# Local Safetensors through MLX: run sh scripts/setup-local.sh
# CONFIG=config/company.local.json
# BIND=127.0.0.1:8788
# RUN_STORE=data/company-runs.sqlite3
GENTS_LOCAL_ONLY=1
